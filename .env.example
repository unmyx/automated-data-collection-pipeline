# =============================================================================
# ADCP configuration - copy to `.env` and adjust.
# All variables are prefixed with ADCP_ and validated at startup.
# Precedence: CLI flag > process environment > .env file > defaults in code.
# =============================================================================

# --- Application -----------------------------------------------------------------
# One of: local | dev | staging | prod
ADCP_ENV=local
# Service name reported in every structured log line.
ADCP_SERVICE_NAME=adcp
# Wall-clock budget for a whole ingestion run, in seconds.
ADCP_RUN_TIMEOUT_S=3600
# Reserved for the `adcp health` command (designed, not implemented - use query 1
# in docs/queries.sql today). Validated at startup.
ADCP_HEALTHCHECK_FRESHNESS_HOURS=3

# --- Logging ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ADCP_LOG_LEVEL=INFO
# json (production) | console (human readable local development)
ADCP_LOG_FORMAT=console
# Include the caller (module:line) in log records. Adds overhead; disable in prod if noisy.
ADCP_LOG_INCLUDE_CALLER=false

# --- Database --------------------------------------------------------------------
# Throwaway local-development credential only. Change it before any real deployment.
ADCP_DATABASE_URL=postgresql+psycopg://adcp:adcp_local_dev@localhost:55432/adcp
# Consumed by docker-compose.yml to provision the local PostgreSQL container.
POSTGRES_USER=adcp
POSTGRES_PASSWORD=adcp_local_dev
POSTGRES_DB=adcp
# Host port only; the container always listens on 5432. 55432 keeps the dev
# stack clear of the PostgreSQL instances developers usually already run.
POSTGRES_PORT=55432
# Pool sizing for the application connection pool.
ADCP_DB_POOL_MIN_SIZE=1
ADCP_DB_POOL_MAX_SIZE=5
ADCP_DB_CONNECT_TIMEOUT_S=5
ADCP_DB_STATEMENT_TIMEOUT_MS=30000
# Statements slower than this are logged at WARNING.
ADCP_DB_SLOW_QUERY_MS=1000

# --- Open-Meteo API ---------------------------------------------------------------
ADCP_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
ADCP_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
ADCP_OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
ADCP_OPEN_METEO_TIMEOUT_CONNECT_S=5
ADCP_OPEN_METEO_TIMEOUT_READ_S=20
ADCP_OPEN_METEO_TIMEOUT_WRITE_S=10
# Wall-clock budget for one logical request across all retry attempts. Each
# attempt is additionally bounded by the connect/read/write timeouts above.
ADCP_OPEN_METEO_TIMEOUT_TOTAL_S=60
ADCP_OPEN_METEO_MAX_ATTEMPTS=5
ADCP_OPEN_METEO_BACKOFF_INITIAL_S=1
ADCP_OPEN_METEO_BACKOFF_MAX_S=30
ADCP_OPEN_METEO_MAX_CONCURRENCY=4
# Reserved for the designed (not built) backfill: pause between chunks so a large
# backfill stays a good API citizen. Validated at startup but not consumed yet.
ADCP_OPEN_METEO_CHUNK_PAUSE_S=0.5
# Attribute traffic to this application when calling the public API.
ADCP_OPEN_METEO_USER_AGENT=adcp/0.1.0 (+https://github.com/depduris/adcp)
# Only needed for a commercial Open-Meteo key; leave empty for the free tier.
ADCP_OPEN_METEO_API_KEY=

# --- Ingestion behaviour -----------------------------------------------------------
# Default lookback window for a scheduled run, in hours.
ADCP_INGEST_LOOKBACK_HOURS=72
# Hours re-fetched before the watermark to absorb upstream forecast revisions.
ADCP_INGEST_OVERLAP_HOURS=24
# Abort the run when this fraction of requested locations has failed (0.0-1.0).
ADCP_INGEST_FAILURE_BUDGET_RATIO=0.5
# Drop a batch (but not the whole run) above this many invalid rows.
ADCP_INGEST_MAX_INVALID_ROW_RATIO=0.25
# Reserved: optional path to a YAML file listing default locations. The loader and
# the `adcp locations import` command are designed but not implemented; locations
# are seeded today with scripts/seed_locations.py.
# ADCP_LOCATIONS_FILE=./config/locations.yaml

# --- Scheduler ---------------------------------------------------------------------
ADCP_SCHEDULER_ENABLED=false
# Minutes past the hour for the recurring collection job.
ADCP_SCHEDULER_MINUTE=7
# Timezone the scheduler evaluates cron expressions in.
ADCP_SCHEDULER_TIMEZONE=UTC
# Skip a scheduled tick if a previous run is still holding the advisory lock.
ADCP_SCHEDULER_SKIP_IF_RUNNING=true
# Development/demo cadence in seconds; 0 keeps the hourly schedule above.
# Values below 60 are for demos and tests only - production schedules hourly.
# ADCP_SCHEDULER_INTERVAL_SECONDS=15

# --- Tests (read by the test suite, not by Settings) --------------------------------
# Point the integration tests at a DISPOSABLE database. Leave unset to let the suite
# use Testcontainers, or fall back to a `<database>_test` sibling of the Compose
# database. The name must contain "test" unless you also export
# ADCP_TEST_ALLOW_ANY_DATABASE=true - the suite truncates tables between tests.
# ADCP_TEST_DATABASE_URL=postgresql+psycopg://adcp:adcp_local_dev@localhost:55432/adcp_test
